# Smart Parking API - environment configuration.
# Copy to `.env` and adjust as needed.

APP_NAME=Smart Parking API

# SQLAlchemy database URL.
# Defaults to sqlite:///<project>/database/smart-parking.db
DATABASE_URL=sqlite:///./database/smart-parking.db

# Comma-free JSON list of allowed CORS origins.
CORS_ORIGINS=["http://localhost:3000"]

# Port the API server listens on.
PORT=5000
