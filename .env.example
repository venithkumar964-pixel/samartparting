# Smart Parking API - optional environment configuration.
# Settings used by the Flask backend (backend/app.py). All values below
# are defaults, so running the project works without a .env file too.

# Port the Flask API server listens on (default 5000).
FLASK_PORT=5000

# Path to the SQLite database file (default: backend/smart_parking.db).
# Can be an absolute or a project-relative path.
SMART_PARKING_DB=backend/smart_parking.db

# Default admin login (seeded automatically on first run):
#   Email:    admin@smartpark.in
#   Password: admin123
# Demo user login:
#   Email:    demo@smartpark.in
#   Password: demo1234